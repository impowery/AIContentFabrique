# === Telegram ===
BOT_TOKEN=1234567890:ABCdefGHIjklmNOPqrstuvwxyz

# === n8n ===
N8N_ENCRYPTION_KEY=replace-with-random-32-char-key
N8N_HOST=localhost
N8N_PROTOCOL=http
N8N_WEBHOOK_URL=http://localhost:5678

# === Database ===
POSTGRES_DB=contentfactory
POSTGRES_USER=cf
POSTGRES_PASSWORD=replace-with-strong-password

# === External APIs (configure in n8n UI) ===
# Groq:     gsk_...
# OpenRouter: sk-or-...
# Cloudflare AI: CF_ACCOUNT_ID + CF_API_TOKEN
# Buffer:    OAuth token
